# =============================================================================
# OperON — environment reference
#
# This file is shaped for LARAVEL CLOUD (see DEPLOY.md). Values here are the
# production-safe defaults; anything genuinely secret is left EMPTY and is set in
# the Laravel Cloud dashboard, never in the repository.
#
# For local development, copy .env.local.example instead — it runs on SQLite and
# needs no services.
# =============================================================================

APP_NAME=OperON
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.laravel.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Laravel Cloud collects stdout. `single` writes one stream; `debug` would leak
# query bindings — and those bindings are costs and margins.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database — Laravel Cloud managed MySQL
#
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD are INJECTED by
# Laravel Cloud when a MySQL database is attached to the environment. Do not set
# them by hand; a custom value overrides the injected one and will break on the
# first credential rotation.
#
# DB_CONNECTION is the exception: set it explicitly, because the app's own default
# is sqlite (for local development) and a missing value would quietly send a
# deployed environment to a file that does not exist.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
# DB_HOST=          # injected by Laravel Cloud
# DB_PORT=3306      # injected by Laravel Cloud
# DB_DATABASE=      # injected by Laravel Cloud
# DB_USERNAME=      # injected by Laravel Cloud
# DB_PASSWORD=      # injected by Laravel Cloud

# Only if the managed database requires SSL (see DEPLOY.md).
# MYSQL_ATTR_SSL_CA="/etc/ssl/certs/ca-certificates.crt"

# -----------------------------------------------------------------------------
# Sessions, cache, queue
#
# All three use the database. Laravel Cloud's container filesystem is EPHEMERAL —
# a `file` driver would sign users out on every deploy and on every request that
# landed on a different replica. Move these to `redis` only after attaching a
# Laravel KV Store.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Real costs and margins behind a login: never let the session cookie travel in clear.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# OperON — first Admin
#
# There is no way into the app without an account and no way to create the first
# one from inside it, so a fresh environment is handed exactly one login from
# outside. `php artisan db:seed --force` reads these on every deploy.
#
# ADMIN_PASSWORD must be at least 12 characters. Changing it and redeploying is
# how you rotate it. SET THESE IN THE DASHBOARD — never commit real values.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# OperON — the money PIN
#
# The second lock on every cost / price / margin screen (§S): a role permission
# gets you to the screen, this PIN opens it, once per session.
#
# There is a default of 1234 in config/operon.php for local work. A production
# environment still sitting on it is REFUSED by the admin bootstrap, because a
# lock everyone knows the combination to is worse than no lock — the screen still
# claims to be protected.
# -----------------------------------------------------------------------------
MONEY_PIN=
OPERON_MONEY_PIN_TIMEOUT=15
OPERON_MONEY_PIN_MAX_ATTEMPTS=5

# Launch rule: every upload is Admin-only. Set to false (and re-seed roles) to
# hand upload rights to Procurement/Warehouse once the team is onboarded.
OPERON_UPLOADS_ADMIN_ONLY=true

# -----------------------------------------------------------------------------
# Raw uploaded files
#
# The PARSED records live in the database and are the source of truth. This is
# only about keeping the original workbook for re-download.
#
# `local` is fine: Laravel Cloud's filesystem is reset by each deploy, so the raw
# file is a within-deployment convenience and the imported data is unaffected. To
# keep the originals, attach a Laravel Cloud object storage bucket, set this to
# `s3`, and fill in the AWS_* block below.
# -----------------------------------------------------------------------------
OPERON_UPLOADS_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="operon@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
