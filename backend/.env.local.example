# =============================================================================
# OperON — local development (Codespace, laptop, anywhere)
#
#   cp .env.local.example .env
#   php artisan key:generate
#   touch database/database.sqlite
#   php artisan migrate --seed
#   composer dev
#
# SQLite, no services to install. The deployed environment runs MySQL — see
# .env.example and DEPLOY.md for that shape.
#
# A NOTE WORTH READING: SQLite is far more forgiving than the managed MySQL this
# app deploys to. It ignores column length limits and does not enforce
# ONLY_FULL_GROUP_BY, so a query or an import that works here can still fail in
# production. If you touch raw SQL or write a column that holds text from a
# spreadsheet, say so in the PR — those are the two things that differ.
# =============================================================================

APP_NAME=OperON
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite: the file is created by `touch database/database.sqlite`.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="operon@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- OperON ---------------------------------------------------------------

# Launch rule: every upload is Admin-only.
OPERON_UPLOADS_ADMIN_ONLY=true

# The money PIN. Fine to leave as the example locally; a production environment
# still on 1234 is refused by `operon:bootstrap-admin`.
MONEY_PIN=1234
OPERON_MONEY_PIN_TIMEOUT=15
OPERON_MONEY_PIN_MAX_ATTEMPTS=5

OPERON_UPLOADS_DISK=local

# `php artisan db:seed` outside production also creates the five demo logins
# (admin@demo.local … warehouse@demo.local, password: password) for previewing
# the role matrix. Setting these additionally creates a real first Admin.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
