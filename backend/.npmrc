ignore-scripts=true
audit=true

# Build the assets even when NODE_ENV=production.
#
# Vite, Tailwind and the Laravel plugin are devDependencies - they build the CSS and JS
# and are not needed at runtime, which is the correct place for them. But npm reads
# NODE_ENV=production as "omit=dev", and a production deploy sets exactly that: `npm ci`
# then installs NOTHING AT ALL, and `npm run build` fails with "vite: not found".
#
# The whole v3 design system is compiled by that build, so this is the difference
# between the deployed app and an unstyled one. Setting it here rather than relying on
# `--include=dev` in the build command means it holds wherever the build runs.
include=dev
